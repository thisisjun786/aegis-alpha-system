#!/usr/bin/env bash
# Pinned Gitleaks: full Git history plus candidate tree, without repo ignore files.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
repo_root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --absolute-git-dir)
scan_dir=$(mktemp -d)
trap 'rm -rf "$scan_dir"' EXIT
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

version=8.30.1
archive="gitleaks_${version}_linux_x64.tar.gz"
checksum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
curl --fail --location --silent --show-error --max-time 60 \
  "https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}" \
  -o "$scan_dir/$archive"
printf '%s  %s\n' "$checksum" "$scan_dir/$archive" | sha256sum --check --status
tar -xzf "$scan_dir/$archive" -C "$scan_dir" gitleaks
# Fresh public history has no inherited exceptions; never accept a repo ignore file.
: > "$scan_dir/reviewed.ignore"

mkdir "$scan_dir/tree"
python3 - "$repo_root" "$scan_dir/tree" <<'PYTHON'
import shutil
import stat
import subprocess
import sys
from pathlib import Path

root, target = map(Path, sys.argv[1:])
names = subprocess.check_output(
    ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root
).decode().split("\0")
for name in sorted(set(names) - {""}):
    source = root / name
    try:
        mode = source.lstat().st_mode
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(mode):
        raise SystemExit(f"non-regular candidate file: {name}")
    dest = target / name
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, dest)
PYTHON

# Scan the Git database from the tool directory so repo ignore files cannot hide findings.
cd "$scan_dir"
./gitleaks git "$git_dir" \
  --config "$repo_root/.gitleaks.toml" \
  --gitleaks-ignore-path "$scan_dir/reviewed.ignore" \
  --ignore-gitleaks-allow --log-opts='--all -m' --redact --no-banner
./gitleaks dir "$scan_dir/tree" \
  --config "$repo_root/.gitleaks.toml" \
  --gitleaks-ignore-path "$scan_dir/reviewed.ignore" \
  --ignore-gitleaks-allow --redact --no-banner
