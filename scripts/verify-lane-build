#!/usr/bin/env bash
# Build sdist/wheel, install into a fresh environment and smoke the installed CLI.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
. "$(dirname "${BASH_SOURCE[0]}")/verify-lib.sh"
ensure_verify_toolchain

scratch="$(mktemp -d /tmp/aas-verify-package.XXXXXXXXXX)"
native_home=""
cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  verify_stop_child
  if [[ -n "$native_home" ]]; then rm -rf -- "$native_home"; fi
  rm -rf -- "$scratch"
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Build isolation may need a build backend absent from the development lock.
verify_run env UV_OFFLINE=0 uv build --python "$AAS_VERIFY_PYTHON" --out-dir "$scratch/dist"
shopt -s nullglob
wheels=("$scratch"/dist/*.whl)
[[ ${#wheels[@]} == 1 ]] || { echo "verify: expected exactly one built wheel" >&2; exit 1; }
sdists=("$scratch"/dist/*.tar.gz)
[[ ${#sdists[@]} == 1 ]] || { echo "verify: expected exactly one built sdist" >&2; exit 1; }
"$AAS_VERIFY_PYTHON" - "${wheels[0]}" "${sdists[0]}" <<'PY'
import sys
from pathlib import Path
from scripts.ci_public import check_distribution

errors = [error for value in sys.argv[1:] for error in check_distribution(Path(value))]
if errors:
    raise SystemExit("\n".join(errors))
print("wheel/sdist contents and legal notices: pass")
PY
verify_run uv export --locked --no-dev --no-emit-project --output-file "$scratch/requirements.txt" >/dev/null
verify_run uv venv --python "$AAS_VERIFY_PYTHON" "$scratch/installed"
verify_run env UV_OFFLINE=0 uv pip install --python "$scratch/installed/bin/python" \
  --require-hashes -r "$scratch/requirements.txt"
verify_run uv pip install --python "$scratch/installed/bin/python" --no-deps "${wheels[0]}"
verify_run uv pip check --python "$scratch/installed/bin/python"
cp "$_AAS_VERIFY_ROOT/examples/portfolio-preview.json" "$scratch/request.json"
cd "$scratch"
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV AAS_TEST_DATABASE_URL AAS_DATA_ROOT AAS_PROJECT_ROOT
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
"$scratch/installed/bin/python" -I - <<'PY'
import sys
from pathlib import Path
import aegis_alpha
import aegis_alpha.engine

if not Path(aegis_alpha.__file__).resolve().is_relative_to(Path(sys.prefix).resolve()):
    sys.exit("verify: smoke imported the checkout instead of the installed wheel")
root = Path(aegis_alpha.__file__).parent
for name in (
    "strategies", "persistence", "data/canonical_production.py",
    "data/canonical_publish.py", "data/postgres_rebind.py",
):
    if (root / name).exists():
        sys.exit(f"verify: retired/private code was installed: {name}")
PY
verify_run "$scratch/installed/bin/aas" status > "$scratch/status.json"
verify_run "$scratch/installed/bin/aas" preview --input "$scratch/request.json" > "$scratch/preview.json"
verify_aas_smoke_json "$scratch/status.json" "$scratch/preview.json"

# Native installation must work with only the base wheel dependencies, outside Git.
native_home="$(mktemp -d /var/tmp/aas-native-package.XXXXXXXXXX)"
verify_run "$scratch/installed/bin/aas" --home "$native_home/aas" init > "$scratch/init.json"
verify_run "$scratch/installed/bin/aas" --home "$native_home/aas" doctor > "$scratch/doctor.json"
verify_run "$scratch/installed/bin/aas" --home "$native_home/aas" db backup --output "$native_home/backup" > "$scratch/backup.json"
verify_run "$scratch/installed/bin/aas" --home "$native_home/restored" db restore --backup "$native_home/backup" > "$scratch/restored.json"
"$scratch/installed/bin/python" -I - "$scratch/doctor.json" "$scratch/restored.json" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path
report = json.loads(Path(sys.argv[1]).read_text())
assert report["ready"] and report["strategy_versions"] == 0
assert report["docker_required"] is False and report["database_server_required"] is False
assert json.loads(Path(sys.argv[2]).read_text())["restored"] is True
assert all(importlib.util.find_spec(name) is None for name in ("sqlalchemy", "psycopg", "alembic", "pyarrow"))
print("installed native init/doctor/backup/restore without PostgreSQL or Parquet dependencies: pass")
PY

# The installation backed up above is empty, so it cannot show that a recorded run
# survives a backup, that an interrupted run recovers, or that the product path works at
# all past status and preview. Seed a synthetic installation through the installed binary,
# then run the whole path under the installed interpreter.
candidate_revision="$(git -C "$_AAS_VERIFY_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
verify_run "$AAS_VERIFY_PYTHON" "$_AAS_VERIFY_ROOT/scripts/verify_installed_scenario.py" seed \
  --aas "$scratch/installed/bin/aas" --root "$native_home/seed" --case "$native_home/case" \
  > "$scratch/seed.json"
verify_run "$scratch/installed/bin/python" -I \
  "$_AAS_VERIFY_ROOT/scripts/verify_installed_scenario.py" scenario \
  --aas "$scratch/installed/bin/aas" --home "$native_home/seed/home" \
  --case "$native_home/case" --work "$native_home/work" > "$scratch/scenario.json"
"$scratch/installed/bin/python" -I - "$scratch/seed.json" "$scratch/scenario.json" \
  "$candidate_revision" "${wheels[0]}" "$_AAS_VERIFY_ROOT/uv.lock" "$scratch/requirements.txt" \
  <<'PY'
import hashlib
import json
import sys
from pathlib import Path


def digest(value: str) -> str:
    return hashlib.sha256(Path(value).read_bytes()).hexdigest()


seed = json.loads(Path(sys.argv[1]).read_text())
scenario = json.loads(Path(sys.argv[2]).read_text())
assert seed["seeded"] is True
assert seed["any_call_saw_pythonpath"] is False
assert scenario["scenario"] == "complete"
assert scenario["any_call_saw_pythonpath"] is False
assert scenario["provenance"]["import_root_inside_prefix"] is True
assert scenario["provenance"]["legacy_extra"] == "not_exercised"
assert len({entry["strategy_id"] for entry in scenario["strategies"]}) >= 2
assert scenario["cases"]["a_cli"]["result_hash"] != scenario["cases"]["b_cli"]["result_hash"]
assert scenario["cases"]["a_api"]["result_hash"] == scenario["cases"]["a_cli"]["result_hash"]
assert scenario["reexecuted_without_seed"]["case_directory_present"] is False
assert scenario["restored_runs"]
assert all(row["identical"] for row in scenario["restored_runs"])
assert scenario["restore_refusals"]["existing_home_unchanged"] is True
assert scenario["restore_refusals"]["nothing_written_before_verification"] is True
assert scenario["restore_refusals"]["tampered_home_is_marked_incomplete"] is True
assert scenario["recovery_without_marker"]["status"] == "INTERRUPTED"
assert scenario["recovery_after_marker"]["status"] == "SUCCESS"
assert scenario["recovery_after_marker"]["sealed_files_unchanged"] is True
for phase in ("recovery_without_marker", "recovery_after_marker"):
    assert scenario[phase]["observers_armed"] is True
    assert scenario[phase]["observers_fired"] == []
assert all(entry["remaining"] is False for entry in scenario["cleanup"]["removed"])
assert all(probe["state"] in {"free", "absent"} for probe in scenario["cleanup"]["lock_probes"])
# Base install only: the legacy extra is never installed here, and the import check above
# is what proves those distributions are absent.
provenance = {
    "candidate_revision": sys.argv[3],
    "wheel_sha256": digest(sys.argv[4]),
    "lock_sha256": digest(sys.argv[5]),
    "requirements_sha256": digest(sys.argv[6]),
    "install_extras": [],
    "base_only": True,
    **scenario["provenance"],
}
print("installed candidate provenance: " + json.dumps(provenance, sort_keys=True))
print("installed registration, run, re-read, backup, restore, refusal and recovery: pass")
PY
rm -rf -- "$native_home"
